{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meridian Installer",
  "version": "0.2.4",
  "identifier": "dev.meridian.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Meridian Installer",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "app"],
    "shortDescription": "Installs and updates Meridian IDLE, the Meridian CLI, the engine SDK and the Rust toolchain.",
    "longDescription": "Installs and updates Meridian IDLE, the Meridian CLI, the engine SDK and the Rust toolchain.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  },
  "mainBinaryName": "meridian-installer"
}
